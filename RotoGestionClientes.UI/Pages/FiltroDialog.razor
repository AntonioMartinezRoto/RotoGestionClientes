@* Diálogo de selección múltiple para los filtros del módulo de Informes.
   Réplica moderna de Informes/FiltroForm.cs (WinForms): una rejilla de
   checkboxes sobre los valores de una categoría (Software, Perfil,
   Manilla...). Trabaja sobre una copia de Items para que, si el usuario
   cancela, no queden marcas a medias; al guardar devuelve la lista de Id
   seleccionados a través de DialogResult.Data. *@
<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Titulo</MudText>
    </TitleContent>
    <DialogContent>
        @if (_items.Count == 0)
        {
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@MenuTextos.SinResultados</MudText>
        }
        else
        {
            <div class="rgc-check-grid">
                @foreach (var item in _items)
                {
                    <MudCheckBox T="bool" Value="item.Selected" ValueChanged="@(v => item.Selected = v)"
                                 Label="@item.Nombre" Dense="true" Color="Color.Primary" />
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">@MenuTextos.Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">@MenuTextos.Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public List<FiltroItem> Items { get; set; } = new();

    private List<FiltroItem> _items = new();

    protected override void OnInitialized()
    {
        _items = Items
            .Select(x => new FiltroItem { Id = x.Id, Nombre = x.Nombre, Selected = x.Selected })
            .ToList();
    }

    private void Aceptar()
    {
        var seleccionados = _items.Where(x => x.Selected).Select(x => x.Id).ToList();
        MudDialog.Close(DialogResult.Ok(seleccionados));
    }

    private void Cancelar() => MudDialog.Cancel();
}
