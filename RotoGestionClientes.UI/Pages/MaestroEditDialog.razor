@* Diálogo genérico de alta/edición de "maestro" (tabla de referencia).
   Réplica moderna de Mantenimiento/MaestroEditForm.cs (WinForms): un mismo
   formulario (Nombre + Activo, con un combo de Tipo de perfil solo para
   Perfiles, un combo de Tipo de usuario -- cargado del catálogo TipoUsuario
   -- solo para Usuarios, y un checkbox "Es distribuidor" solo para el propio
   catálogo de Tipos de usuario) que sirve para las 12 categorías de maestros
   del módulo de Mantenimiento. Al guardar, incrementa
   ConfiguracionAplicacion.VersionMaestros igual que IncrementarVersionDatos()
   en la app legacy. *@
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject VersionDatosState VersionDatosState
@inject AuditoriaService AuditoriaService
@using Microsoft.EntityFrameworkCore

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@Titulo</MudText>
    </TitleContent>
    <DialogContent>
        @if (_cargando)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
        }
        else
        {
            <MudStack Spacing="3">
                <MudTextField T="string" @bind-Value="_nombre" Label="@MenuTextos.Nombre" Variant="Variant.Outlined"
                              Required="true" RequiredError="@MenuTextos.NombreObligatorio" />

                @if (Tipo == MaestroTipo.Perfil)
                {
                    <MudSelect T="int?" Label="@MenuTextos.Tipo" Value="_perfilTipoId" ValueChanged="@(v => _perfilTipoId = v)"
                               Variant="Variant.Outlined">
                        @foreach (var tipo in _perfilTipos)
                        {
                            <MudSelectItem T="int?" Value="@((int?)tipo.Id)">@tipo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }

                @if (Tipo == MaestroTipo.Usuario)
                {
                    <MudSelect T="int?" Label="@MenuTextos.TipoUsuario" Value="_tipoUsuarioId" ValueChanged="@(v => _tipoUsuarioId = v)"
                               Variant="Variant.Outlined" Required="true" RequiredError="@MenuTextos.TipoUsuarioObligatorio">
                        @foreach (var tipo in _tiposUsuario)
                        {
                            <MudSelectItem T="int?" Value="@((int?)tipo.Id)">@tipo.Nombre</MudSelectItem>
                        }
                    </MudSelect>
                }

                <MudCheckBox T="bool" @bind-Value="_activo" Label="@MenuTextos.Activo" Color="Color.Primary" />

                @if (Tipo == MaestroTipo.TipoUsuario)
                {
                    <MudCheckBox T="bool" @bind-Value="_esDistribuidorTipo" Label="@MenuTextos.EsDistribuidor" Color="Color.Primary" />
                }
            </MudStack>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">@MenuTextos.Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AceptarAsync" Disabled="_guardando">@MenuTextos.Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public string Titulo { get; set; } = string.Empty;
    [Parameter, EditorRequired] public MaestroTipo Tipo { get; set; }
    [Parameter] public int? Id { get; set; }

    private bool _cargando = true;
    private bool _guardando;

    private string _nombre = string.Empty;
    private bool _activo = true;
    private int? _tipoUsuarioId;
    private bool _esDistribuidorTipo;
    private int? _perfilTipoId;
    private List<PerfilTipo> _perfilTipos = new();
    private List<TipoUsuario> _tiposUsuario = new();

    // Fotografía de los valores tal como estaban en la BBDD al abrir el
    // diálogo (solo se rellenan cuando Id.HasValue), para poder detectar en
    // AceptarAsync si Guardar realmente cambia algo -- ver huboCambios ahí.
    private string _nombreOriginal = string.Empty;
    private bool _activoOriginal;
    private int? _tipoUsuarioIdOriginal;
    private bool _esDistribuidorTipoOriginal;
    private int? _perfilTipoIdOriginal;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        if (Tipo == MaestroTipo.Perfil)
            _perfilTipos = await db.PerfilTipos.Where(x => x.Activa).OrderBy(x => x.Nombre).AsNoTracking().ToListAsync();

        if (Tipo == MaestroTipo.Usuario)
        {
            _tiposUsuario = await db.TiposUsuario.Where(x => x.Activa).OrderBy(x => x.Nombre).AsNoTracking().ToListAsync();
            // Por defecto, al dar de alta un usuario nuevo, se preselecciona
            // el primer tipo del catálogo (en vez de dejarlo vacío) para que
            // el caso más común no obligue a abrir el desplegable.
            if (Id is null && _tiposUsuario.Count > 0)
                _tipoUsuarioId = _tiposUsuario[0].Id;
        }

        if (Id.HasValue)
        {
            switch (Tipo)
            {
                case MaestroTipo.Perfil:
                    {
                        var e = await db.Perfiles.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                        _perfilTipoId = e.PerfilTipoId;
                    }
                    break;

                case MaestroTipo.Software:
                    {
                        var e = await db.Softwares.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.Manilla:
                    {
                        var e = await db.Manillas.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.CerraduraPuerta:
                    {
                        var e = await db.CerradurasPuerta.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.BisagraPuerta:
                    {
                        var e = await db.Bisagras.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.SeguridadVentana:
                    {
                        var e = await db.SeguridadVentanas.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.CremonaPasivaVentana:
                    {
                        var e = await db.CremonaPasivaVentanaTipos.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.MaquinaMantenimiento:
                    {
                        var e = await db.MaquinasMantenimiento.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.MaquinaMarcas:
                    {
                        var e = await db.MaquinasMarcas.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.MaquinaTipo:
                    {
                        var e = await db.MaquinasTipos.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Descripcion;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.Usuario:
                    {
                        var e = await db.Usuarios.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                        _tipoUsuarioId = e.TipoUsuarioId;
                    }
                    break;

                case MaestroTipo.TipoAccion:
                    {
                        var e = await db.TiposAccion.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                    }
                    break;

                case MaestroTipo.TipoUsuario:
                    {
                        var e = await db.TiposUsuario.AsNoTracking().FirstAsync(x => x.Id == Id.Value);
                        _nombre = e.Nombre;
                        _activo = e.Activa;
                        _esDistribuidorTipo = e.EsDistribuidor;
                    }
                    break;
            }

            // Fotografía tras el switch: cualquiera que sea el Tipo, en este
            // punto _nombre/_activo/_perfilTipoId/_tipoUsuarioId/
            // _esDistribuidorTipo tienen exactamente lo que había en la BBDD
            // (los que no aplican a este Tipo se quedan en su valor por
            // defecto en ambos lados, así que no afectan a la comparación).
            _nombreOriginal = _nombre;
            _activoOriginal = _activo;
            _perfilTipoIdOriginal = _perfilTipoId;
            _tipoUsuarioIdOriginal = _tipoUsuarioId;
            _esDistribuidorTipoOriginal = _esDistribuidorTipo;
        }

        _cargando = false;
    }

    private async Task AceptarAsync()
    {
        var nombre = _nombre.Trim();
        if (string.IsNullOrWhiteSpace(nombre))
        {
            Snackbar.Add(MenuTextos.NombreObligatorio, Severity.Warning);
            return;
        }

        if (Tipo == MaestroTipo.Perfil && !_perfilTipoId.HasValue)
        {
            Snackbar.Add(MenuTextos.TipoPerfilObligatorio, Severity.Warning);
            return;
        }

        if (Tipo == MaestroTipo.Usuario && !_tipoUsuarioId.HasValue)
        {
            Snackbar.Add(MenuTextos.TipoUsuarioObligatorio, Severity.Warning);
            return;
        }

        // Si se está editando (Id.HasValue) y ninguno de los campos ha
        // cambiado respecto a lo que había al abrir el diálogo, no hay nada
        // que guardar: se evita registrar auditoría e incrementar
        // VersionMaestros (que dispararía una descarga de actualización
        // innecesaria en Distribuidor) por un "Guardar" que no modifica nada.
        var huboCambios = Id is null
            || nombre != _nombreOriginal
            || _activo != _activoOriginal
            || (Tipo == MaestroTipo.Perfil && _perfilTipoId != _perfilTipoIdOriginal)
            || (Tipo == MaestroTipo.Usuario && _tipoUsuarioId != _tipoUsuarioIdOriginal)
            || (Tipo == MaestroTipo.TipoUsuario && _esDistribuidorTipo != _esDistribuidorTipoOriginal);

        if (!huboCambios)
        {
            MudDialog.Close(DialogResult.Ok(true));
            return;
        }

        _guardando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var entidadId = 0;

            switch (Tipo)
            {
                case MaestroTipo.Perfil:
                    {
                        var entity = Id is null ? new Perfil() : await db.Perfiles.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<Perfil>(db);
                            db.Perfiles.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entity.PerfilTipoId = _perfilTipoId!.Value;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.Software:
                    {
                        var entity = Id is null ? new Software() : await db.Softwares.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<Software>(db);
                            db.Softwares.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.Manilla:
                    {
                        var entity = Id is null ? new Manilla() : await db.Manillas.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<Manilla>(db);
                            db.Manillas.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.CerraduraPuerta:
                    {
                        var entity = Id is null ? new CerraduraPuerta() : await db.CerradurasPuerta.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<CerraduraPuerta>(db);
                            db.CerradurasPuerta.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.BisagraPuerta:
                    {
                        var entity = Id is null ? new Bisagra() : await db.Bisagras.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<Bisagra>(db);
                            db.Bisagras.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.SeguridadVentana:
                    {
                        var entity = Id is null ? new SeguridadVentana() : await db.SeguridadVentanas.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<SeguridadVentana>(db);
                            db.SeguridadVentanas.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.CremonaPasivaVentana:
                    {
                        var entity = Id is null ? new CremonaPasivaVentanaTipos() : await db.CremonaPasivaVentanaTipos.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<CremonaPasivaVentanaTipos>(db);
                            db.CremonaPasivaVentanaTipos.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.MaquinaMantenimiento:
                    {
                        var entity = Id is null ? new MaquinaMantenimiento() : await db.MaquinasMantenimiento.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<MaquinaMantenimiento>(db);
                            db.MaquinasMantenimiento.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.MaquinaMarcas:
                    {
                        var entity = Id is null ? new MaquinaMarca() : await db.MaquinasMarcas.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<MaquinaMarca>(db);
                            db.MaquinasMarcas.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.MaquinaTipo:
                    {
                        var entity = Id is null ? new MaquinaTipo() : await db.MaquinasTipos.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<MaquinaTipo>(db);
                            db.MaquinasTipos.Add(entity);
                        }
                        entity.Descripcion = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.Usuario:
                    {
                        var entity = Id is null ? new Usuario() : await db.Usuarios.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<Usuario>(db);
                            db.Usuarios.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entity.TipoUsuarioId = _tipoUsuarioId!.Value;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.TipoAccion:
                    {
                        var entity = Id is null ? new TipoAccion() : await db.TiposAccion.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<TipoAccion>(db);
                            db.TiposAccion.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entidadId = entity.Id;
                    }
                    break;

                case MaestroTipo.TipoUsuario:
                    {
                        var entity = Id is null ? new TipoUsuario() : await db.TiposUsuario.FirstAsync(x => x.Id == Id.Value);
                        if (Id is null)
                        {
                            entity.Id = await NuevoIdAsync<TipoUsuario>(db);
                            db.TiposUsuario.Add(entity);
                        }
                        entity.Nombre = nombre;
                        entity.Activa = _activo;
                        entity.EsDistribuidor = _esDistribuidorTipo;
                        entidadId = entity.Id;
                    }
                    break;
            }

            var accionAuditoria = Id is null ? AuditoriaAccionTipo.Crear : AuditoriaAccionTipo.Modificar;
            AuditoriaService.Registrar(db, accionAuditoria, Tipo.ToString(), entidadId, nombre);

            var nuevaVersion = await IncrementarVersionDatosAsync(db);
            await db.SaveChangesAsync();

            // Refleja al instante la nueva versión en la cabecera de la app
            // (MainLayout), que no se reinstancia al navegar y por tanto no
            // se enteraría del cambio salvo por este aviso explícito.
            VersionDatosState.Establecer(nuevaVersion);

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();

    // Igual que NuevoId<T>() en MaestroEditForm.cs: estas tablas de maestros
    // no usan IDENTITY (Id se asigna a mano), así que el siguiente Id
    // disponible es el máximo actual + 1.
    private static async Task<int> NuevoIdAsync<TEntity>(ApplicationDbContext db) where TEntity : class
    {
        var ids = await db.Set<TEntity>().Select(x => EF.Property<int>(x, "Id")).ToListAsync();
        return ids.Count > 0 ? ids.Max() + 1 : 1;
    }

    // Igual que IncrementarVersionDatos() en MaestroEditForm.cs. Devuelve la
    // nueva versión para poder reflejarla al instante en la cabecera de la
    // app (VersionDatosState) sin esperar a un SaveChangesAsync posterior.
    private static async Task<string> IncrementarVersionDatosAsync(ApplicationDbContext db)
    {
        var configuracion = await db.ConfiguracionAplicacion.FirstAsync();
        var partes = configuracion.VersionMaestros.Split('.');

        var mayor = int.Parse(partes[0]);
        var menor = int.Parse(partes[1]);

        menor++;
        if (menor > 99)
        {
            mayor++;
            menor = 0;
        }

        configuracion.VersionMaestros = $"{mayor}.{menor}";
        return configuracion.VersionMaestros;
    }
}
