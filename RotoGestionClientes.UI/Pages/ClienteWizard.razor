@* Wizard de alta/edición de clientes. Réplica moderna de Clientes/ClienteWizard.cs
   (WinForms). Los 8 pasos ("Datos generales", "Ventanas", "Balconeras",
   "Puertas", "Correderas", "Elevables/Plegables", "Máquinas" y
   "Documentos") están totalmente funcionales contra BBDD. *@
@page "/clientes/nuevo"
@page "/clientes/editar/{ClienteId:int}"
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@using Microsoft.EntityFrameworkCore
@using System.ComponentModel

<div class="rgc-wizard">
    <div class="rgc-wizard-header">
        <MudText Typo="Typo.h5">@_titulo</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@_subtitulo</MudText>
    </div>

    @if (_cargandoInicial)
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-4" />
    }
    else
    {
        <div class="rgc-wizard-body">
            <div class="rgc-wizard-sidebar">
                @for (var i = 0; i < _pasos.Count; i++)
                {
                    var index = i;
                    var estado = EstadoPaso(index);
                    <div class="rgc-wizard-step rgc-wizard-step-@estado @(_mode == WizardMode.Edit ? "rgc-clickable" : "")"
                         @onclick="@(() => IrAPaso(index))">
                        <span class="rgc-wizard-step-badge">
                            @if (estado == "completado")
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" />
                            }
                            else
                            {
                                @((index + 1).ToString())
                            }
                        </span>
                        <span class="rgc-wizard-step-label">@_pasos[index]</span>
                    </div>
                }
            </div>

            <div class="rgc-wizard-content">
                @if (_currentStep == 0)
                {
                    <PasoDatosGeneralesStep Model="_model" />
                }
                else if (_currentStep == 1)
                {
                    <PasoVentanasStep Model="_model" />
                }
                else if (_currentStep == 2)
                {
                    <PasoBalconerasStep Model="_model" />
                }
                else if (_currentStep == 3)
                {
                    <PasoPuertasStep Model="_model" />
                }
                else if (_currentStep == 4)
                {
                    <PasoCorrederasStep Model="_model" />
                }
                else if (_currentStep == 5)
                {
                    <PasoElevablesPlegablesStep Model="_model" />
                }
                else if (_currentStep == 6)
                {
                    <PasoMaquinasStep Model="_model" />
                }
                else if (_currentStep == 7)
                {
                    <PasoDocumentosStep Model="_model" />
                }
                else
                {
                    <MudPaper Outlined="true" Class="pa-8 rgc-wizard-placeholder">
                        @{ var imagenes = ImagenesPaso(_currentStep); }
                        @if (imagenes.Count > 0)
                        {
                            <div class="rgc-step-images rgc-step-images-placeholder">
                                @foreach (var src in imagenes)
                                {
                                    <img src="@src" alt="@_pasos[_currentStep]" />
                                }
                            </div>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Large" Class="mb-4 mud-text-secondary" />
                        }
                        <MudText Typo="Typo.h6" Class="mb-2 mt-4">@_pasos[_currentStep]</MudText>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">@MenuTextos.PasoProximamenteTexto</MudText>
                    </MudPaper>
                }
            </div>
        </div>

        <div class="rgc-wizard-footer">
            <MudButton Variant="Variant.Outlined" OnClick="Cancelar" Disabled="_guardando">@MenuTextos.Cancelar</MudButton>
            <MudSpacer />
            @if (_mode == WizardMode.Create)
            {
                <MudButton Variant="Variant.Outlined" OnClick="Atras" Disabled="@(_currentStep == 0 || _guardando)">@MenuTextos.Atras</MudButton>
                @if (_currentStep < _pasos.Count - 1)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Siguiente" Disabled="_guardando">@MenuTextos.Siguiente</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar" Disabled="_guardando">@MenuTextos.Finalizar</MudButton>
                }
            }
            else
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Guardar" Disabled="_guardando">@MenuTextos.Guardar</MudButton>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int? ClienteId { get; set; }

    private WizardMode _mode;
    private ClientWizardModel _model = new();
    private int _currentStep;
    private bool _cargandoInicial = true;
    private bool _guardando;
    private string _titulo = string.Empty;
    private string _subtitulo = string.Empty;
    private List<string> _pasos = new();

    protected override async Task OnInitializedAsync()
    {
        _pasos =
        [
            MenuTextos.DatosGenerales,
            MenuTextos.Ventanas,
            MenuTextos.Balconeras,
            MenuTextos.Puertas,
            MenuTextos.Correderas,
            MenuTextos.ElevablesPlegables,
            MenuTextos.Maquinas,
            MenuTextos.Documentos,
        ];

        if (ClienteId.HasValue)
        {
            _mode = WizardMode.Edit;

            var modelo = await CargarModeloAsync(ClienteId.Value);
            if (modelo is null)
            {
                Snackbar.Add(MenuTextos.DatosCorruptos, Severity.Warning);
                NavigationManager.NavigateTo("/clientes");
                return;
            }

            _model = modelo;
            _titulo = _model.Nombre;
            _subtitulo = MenuTextos.EditandoCliente;
        }
        else
        {
            _mode = WizardMode.Create;
            _model = new ClientWizardModel();
            _titulo = MenuTextos.NuevoCliente;
            _subtitulo = MenuTextos.CompletarDatosCliente;
        }

        _cargandoInicial = false;
    }

    // Imágenes representativas por paso (las mismas que la app WinForms
    // legacy usa como apoyo visual en cada pantalla del wizard), para los
    // pasos que todavía no están migrados y solo muestran un placeholder.
    // El paso 0 (Datos generales) no lleva imagen a propósito.
    private static readonly Dictionary<int, string[]> ImagenesPorPaso = new();

    private static IReadOnlyList<string> ImagenesPaso(int index) =>
        ImagenesPorPaso.TryGetValue(index, out var imagenes) ? imagenes : Array.Empty<string>();

    private string EstadoPaso(int index)
    {
        if (_mode == WizardMode.Edit)
            return index == _currentStep ? "activo" : "pendiente";

        if (index < _currentStep) return "completado";
        return index == _currentStep ? "activo" : "pendiente";
    }

    private void IrAPaso(int index)
    {
        if (_mode == WizardMode.Edit)
            _currentStep = index;
    }

    private void Siguiente()
    {
        if (_currentStep < _pasos.Count - 1)
            _currentStep++;
    }

    private void Atras()
    {
        if (_currentStep > 0)
            _currentStep--;
    }

    private void Cancelar()
    {
        NavigationManager.NavigateTo("/clientes");
    }

    private async Task Guardar()
    {
        if (!await EsModeloValidoAsync())
            return;

        _guardando = true;
        try
        {
            if (_mode == WizardMode.Create)
                await CrearClienteAsync();
            else
                await ActualizarClienteAsync();

            Snackbar.Add(
                _mode == WizardMode.Create ? MenuTextos.ClienteCreado : MenuTextos.ClienteActualizado,
                Severity.Success,
                config => { config.SnackbarVariant = Variant.Filled; });

            NavigationManager.NavigateTo("/clientes");
        }
        finally
        {
            _guardando = false;
        }
    }

    private async Task<bool> EsModeloValidoAsync()
    {
        if (string.IsNullOrWhiteSpace(_model.Nombre))
        {
            Snackbar.Add(MenuTextos.NombreClienteObligatorio, Severity.Warning);
            return false;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var nombreNormalizado = _model.Nombre.Trim().ToUpperInvariant();

        if (_mode == WizardMode.Create)
        {
            var existe = await db.Clientes.AnyAsync(c => c.Nombre.ToUpper().Trim() == nombreNormalizado);
            if (existe)
            {
                Snackbar.Add(MenuTextos.ClienteExistente, Severity.Warning);
                return false;
            }
        }
        else
        {
            var clienteActual = await db.Clientes.AsNoTracking().FirstOrDefaultAsync(c => c.Id == _model.Id);
            if (clienteActual is null)
            {
                Snackbar.Add(MenuTextos.DatosCorruptos, Severity.Warning);
                return false;
            }

            if (clienteActual.Nombre.Trim().ToUpper() != nombreNormalizado)
            {
                var existeOtro = await db.Clientes.AnyAsync(c => c.Id != _model.Id && c.Nombre.ToUpper().Trim() == nombreNormalizado);
                if (existeOtro)
                {
                    Snackbar.Add(MenuTextos.ClienteExistente, Severity.Warning);
                    return false;
                }
            }
        }

        return true;
    }

    // --- Carga y guardado -------------------------------------------------
    //
    // IMPORTANTE (alcance de esta fase): solo se leen/escriben los campos de
    // los pasos ya migrados: "Datos generales" (Nombre, SapId, Alias,
    // Comentarios, Responsable, Software, tipos de perfil, perfiles,
    // manillas, soporte compás), "Ventanas" (seguridad, hoja pasiva de
    // oscilobatientes y de practicables, observaciones), "Balconeras"
    // (seguridad, hoja pasiva, bisagras y cerraduras de puerta secundaria,
    // aguja de montaje y observaciones), "Puertas" (bisagras, cerraduras,
    // cilindros, aguja de montaje y observaciones), "Correderas" (agujas de
    // corredera, bombillo y observaciones), "Elevables/Plegables" (Estándar,
    // DLO, Consumen y observaciones de ambos bloques), "Máquinas" (lista de
    // máquinas del cliente, bisagras en soldadora, triple taladro en centro
    // de mecanizado, soporte de marco y observaciones) y "Documentos"
    // (ficheros adjuntos del cliente y observaciones). Con esto quedan
    // cubiertos los 8 pasos del wizard.
    //
    // Caso especial — "aguja de montaje" (tabla ClienteAgujas): es una única
    // fila por cliente con columnas para Balconera, Puerta secundaria y
    // Puerta, y la tabla de detalle ClienteAgujasModeloPerfil mezcla filas
    // de los tres tipos. Ahora que los tres pasos (Balconeras, Puerta
    // secundaria dentro de Balconeras, y Puertas) están migrados, las tres
    // columnas/tipos son editables desde esta UI; se siguen cargando y
    // guardando siempre juntas porque comparten la misma fila/tabla física.
    //
    // Caso especial — "Portero eléctrico" (tabla ClienteConfiguracionPuerta,
    // columna PorteroElectrico): en la app legacy el control de este campo
    // está oculto (group_Portero.Visible = false en PasoPuertas.Designer.cs)
    // y nunca se muestra al usuario, aunque comparte fila con "Cilindro" (que
    // sí es editable). Por eso aquí también se carga y se vuelve a guardar
    // sin exponer ningún control, para no perder el valor ya guardado.

    private async Task<ClientWizardModel?> CargarModeloAsync(int clienteId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var cliente = await db.Clientes.AsNoTracking().FirstOrDefaultAsync(c => c.Id == clienteId);
        if (cliente is null)
            return null;

        var modelo = new ClientWizardModel
        {
            Id = cliente.Id,
            Nombre = cliente.Nombre,
            SapId = cliente.SapId,
            Alias = cliente.Alias,
            Comentarios = cliente.Comentarios,
            ResponsableId = cliente.ResponsableId,
            ObservacionesVentanas = cliente.ObservacionesVentanas,
            ObservacionesBalconeras = cliente.ObservacionesBalconeras,
            ObservacionesPuertas = cliente.ObservacionesPuertas,
            ObservacionesCorrederas = cliente.ObservacionesCorrederas,
            ObservacionesElevables = cliente.ObservacionesElevables,
            ObservacionesPlegables = cliente.ObservacionesPlegables,
            ObservacionesMaquinas = cliente.ObservacionesMaquinas,
            ObservacionesDocumentos = cliente.ObservacionesDocumentos,
            SoftwareList = await db.ClienteSoftwares.Where(x => x.ClienteId == clienteId).Select(x => x.SoftwareId).ToListAsync(),
            PerfilTipoList = await db.ClientePerfilTipos.Where(x => x.ClienteId == clienteId).Select(x => x.PerfilTipoId).ToListAsync(),
            PerfilesList = await db.ClientePerfiles.Where(x => x.ClienteId == clienteId).Select(x => x.PerfilId).ToListAsync(),
            ManillasList = await db.ClienteManillas.Where(x => x.ClienteId == clienteId).Select(x => x.ManillaId).ToListAsync(),
            SoporteCompasList = await db.ClienteSoporteCompases.Where(x => x.ClienteId == clienteId).Select(x => x.SoporteCompasId).ToListAsync(),
            SeguridadVentanaList = await db.ClienteSeguridadVentanas.Where(x => x.ClienteId == clienteId).Select(x => x.SeguridadVentanaId).ToListAsync(),
            CremonaPasivaVentanaList = await db.ClienteCremonaPasivaVentanas.Where(x => x.ClienteId == clienteId).Select(x => x.CremonaPasivaVentanaId).ToListAsync(),
            CremonaPasivaVentanaPractList = await db.ClienteCremonaPasivaVentanasPract.Where(x => x.ClienteId == clienteId).Select(x => x.CremonaPasivaVentanaId).ToListAsync(),
            SeguridadBalconeraList = await db.ClienteSeguridadBalconeras.Where(x => x.ClienteId == clienteId).Select(x => x.SeguridadBalconeraId).ToListAsync(),
            CremonaPasivaBalconeraList = await db.ClienteCremonaPasivaBalconeras.Where(x => x.ClienteId == clienteId).Select(x => x.CremonaPasivaBalconeraId).ToListAsync(),
            BisagrasPuertaSecList = await db.ClienteBisagraPuertasSec.Where(x => x.ClienteId == clienteId).Select(x => x.BisagraPuertaId).ToListAsync(),
            CerradurasPuertaSecList = await db.ClienteCerradurasPuertaSec.Where(x => x.ClienteId == clienteId).Select(x => x.CerraduraPuertaSecId).ToListAsync(),
            BisagrasPuertaList = await db.ClienteBisagraPuertas.Where(x => x.ClienteId == clienteId).Select(x => x.BisagraPuertaId).ToListAsync(),
            CerradurasPuertaList = await db.ClienteCerradurasPuerta.Where(x => x.ClienteId == clienteId).Select(x => x.CerraduraPuertaId).ToListAsync(),
            CilindroList = await db.ClienteCilindros.Where(x => x.ClienteId == clienteId).Select(x => x.CilindroId).ToListAsync(),
            AgujasCorrederaList = await db.ClienteAgujasCorrederas.Where(x => x.ClienteId == clienteId).Select(x => x.AgujaCorrederaId).ToListAsync(),
            AgujasModeloPerfilList = await db.ClienteAgujasModeloPerfil.Where(x => x.ClienteId == clienteId)
                .Select(x => new AgujaModeloPerfilItem { AgujaModeloTipoId = x.AgujaModeloTipoId, AgujaId = x.AgujaId, PerfilId = x.PerfilId })
                .ToListAsync(),
            MaquinasList = new BindingList<ClienteMaquinaItem>(await db.ClienteMaquinas.Where(x => x.ClienteId == clienteId)
                .OrderBy(x => x.Id)
                .Select(x => new ClienteMaquinaItem
                {
                    Id = x.Id,
                    MaquinaTipoId = x.MaquinaTipoId,
                    Descripcion = x.MaquinaTipo.Descripcion,
                    MaquinaMarcaId = x.MaquinaMarcaId,
                    MarcaNombre = x.MaquinaMarca != null ? x.MaquinaMarca.Nombre : null,
                    MaquinaMantenimientoId = x.MaquinaMantenimientoId,
                    MantenimientoNombre = x.MaquinaMantenimiento.Nombre,
                    Observaciones = x.Observaciones
                })
                .ToListAsync()),
            // Solo se cargan los metadatos (no el contenido del fichero, que
            // pesaría mucho para toda la lista): igual que CargarModeloAsync
            // en la app legacy, el contenido se lee bajo demanda al
            // descargar un documento concreto.
            DocumentosList = new BindingList<ClienteDocumentoItem>(await db.ClienteDocumentos.Where(x => x.ClienteId == clienteId)
                .OrderBy(x => x.Id)
                .Select(x => new ClienteDocumentoItem
                {
                    Id = x.Id,
                    Nombre = x.Nombre,
                    NombreFicheroOriginal = x.NombreFicheroOriginal,
                    Extension = x.Extension,
                    TamañoBytes = x.TamañoBytes
                })
                .ToListAsync()),
        };

        var clienteAgujas = await db.ClienteAgujases.AsNoTracking().FirstOrDefaultAsync(x => x.ClienteId == clienteId);
        modelo.AgujaBalconeraTipo = clienteAgujas?.AgujaBalconeraTipoId ?? (int)AgujaMode.Todos;
        modelo.AgujaBalconera = clienteAgujas?.AgujaBalconeraId;
        modelo.AgujaPuertaSecTipo = clienteAgujas?.AgujaPuertaSecTipoId ?? (int)AgujaMode.Todos;
        modelo.AgujaPuertaSec = clienteAgujas?.AgujaPuertaSecId;
        modelo.AgujaPuertaTipo = clienteAgujas?.AgujaPuertaTipoId ?? (int)AgujaMode.Todos;
        modelo.AgujaPuerta = clienteAgujas?.AgujaPuertaId;

        var clienteConfiguracionPuerta = await db.ClienteConfiguracionPuerta.AsNoTracking().FirstOrDefaultAsync(x => x.ClienteId == clienteId);
        modelo.PorteroElectrico = clienteConfiguracionPuerta?.PorteroElectrico ?? false;
        modelo.Cilindro = clienteConfiguracionPuerta?.Cilindro ?? false;

        var clienteCilindroCorredera = await db.ClienteCilindrosCorredera.AsNoTracking().FirstOrDefaultAsync(x => x.ClienteId == clienteId);
        modelo.CilindroCorredera = clienteCilindroCorredera?.Cilindro ?? false;

        var clienteElevablePlegable = await db.ClienteConfiguracionElevablePlegables.AsNoTracking().FirstOrDefaultAsync(x => x.ClienteId == clienteId);
        modelo.Elevable_Estandar = clienteElevablePlegable?.Elevable_Estandar ?? false;
        modelo.Elevable_Dlo = clienteElevablePlegable?.Elevable_Dlo ?? false;
        modelo.Plegable_Consumen = clienteElevablePlegable?.Plegable_Consumen ?? false;

        var clienteConfiguracionMaquinas = await db.ClienteConfiguracionMaquinas.AsNoTracking().FirstOrDefaultAsync(x => x.ClienteId == clienteId);
        modelo.BisagraEnSoldadora = clienteConfiguracionMaquinas?.BisagrasSoldadora ?? false;
        modelo.TripleTaladroCentro = clienteConfiguracionMaquinas?.TripleTaladroCentro ?? false;
        modelo.SoporteMarcoConfigId = clienteConfiguracionMaquinas?.SoporteMarcoId ?? (int)Enums.SoporteMarcoConfig.CentroMecanizado;

        return modelo;
    }

    private async Task CrearClienteAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var cliente = new Cliente
        {
            Nombre = _model.Nombre,
            SapId = _model.SapId,
            Alias = _model.Alias,
            Comentarios = _model.Comentarios,
            ResponsableId = _model.ResponsableId,
            ObservacionesVentanas = _model.ObservacionesVentanas,
            ObservacionesBalconeras = _model.ObservacionesBalconeras,
            ObservacionesPuertas = _model.ObservacionesPuertas,
            ObservacionesCorrederas = _model.ObservacionesCorrederas,
            ObservacionesElevables = _model.ObservacionesElevables,
            ObservacionesPlegables = _model.ObservacionesPlegables,
            ObservacionesMaquinas = _model.ObservacionesMaquinas,
            ObservacionesDocumentos = _model.ObservacionesDocumentos
        };

        db.Clientes.Add(cliente);
        await db.SaveChangesAsync();

        foreach (var perfilTipoId in _model.PerfilTipoList)
            db.ClientePerfilTipos.Add(new ClientePerfilTipo { ClienteId = cliente.Id, PerfilTipoId = perfilTipoId });

        foreach (var perfilId in _model.PerfilesList)
            db.ClientePerfiles.Add(new ClientePerfil { ClienteId = cliente.Id, PerfilId = perfilId });

        foreach (var manillaId in _model.ManillasList)
            db.ClienteManillas.Add(new ClienteManilla { ClienteId = cliente.Id, ManillaId = manillaId });

        foreach (var soporteCompasId in _model.SoporteCompasList)
            db.ClienteSoporteCompases.Add(new ClienteSoporteCompas { ClienteId = cliente.Id, SoporteCompasId = soporteCompasId });

        if (_model.SoftwareList.Count > 0)
            db.ClienteSoftwares.Add(new ClienteSoftware { ClienteId = cliente.Id, SoftwareId = _model.SoftwareList[0] });

        foreach (var seguridadVentanaId in _model.SeguridadVentanaList)
            db.ClienteSeguridadVentanas.Add(new ClienteSeguridadVentana { ClienteId = cliente.Id, SeguridadVentanaId = seguridadVentanaId });

        foreach (var cremonaId in _model.CremonaPasivaVentanaList)
            db.ClienteCremonaPasivaVentanas.Add(new ClienteCremonaPasivaVentana { ClienteId = cliente.Id, CremonaPasivaVentanaId = cremonaId });

        foreach (var cremonaId in _model.CremonaPasivaVentanaPractList)
            db.ClienteCremonaPasivaVentanasPract.Add(new ClienteCremonaPasivaVentanaPract { ClienteId = cliente.Id, CremonaPasivaVentanaId = cremonaId });

        foreach (var seguridadBalconeraId in _model.SeguridadBalconeraList)
            db.ClienteSeguridadBalconeras.Add(new ClienteSeguridadBalconera { ClienteId = cliente.Id, SeguridadBalconeraId = seguridadBalconeraId });

        foreach (var cremonaId in _model.CremonaPasivaBalconeraList)
            db.ClienteCremonaPasivaBalconeras.Add(new ClienteCremonaPasivaBalconera { ClienteId = cliente.Id, CremonaPasivaBalconeraId = cremonaId });

        foreach (var bisagraId in _model.BisagrasPuertaSecList)
            db.ClienteBisagraPuertasSec.Add(new ClienteBisagraPuertaSec { ClienteId = cliente.Id, BisagraPuertaId = bisagraId });

        foreach (var cerraduraId in _model.CerradurasPuertaSecList)
            db.ClienteCerradurasPuertaSec.Add(new ClienteCerraduraPuertaSec { ClienteId = cliente.Id, CerraduraPuertaSecId = cerraduraId });

        foreach (var bisagraId in _model.BisagrasPuertaList)
            db.ClienteBisagraPuertas.Add(new ClienteBisagraPuerta { ClienteId = cliente.Id, BisagraPuertaId = bisagraId });

        foreach (var cerraduraId in _model.CerradurasPuertaList)
            db.ClienteCerradurasPuerta.Add(new ClienteCerraduraPuerta { ClienteId = cliente.Id, CerraduraPuertaId = cerraduraId });

        foreach (var cilindroId in _model.CilindroList)
            db.ClienteCilindros.Add(new ClienteCilindro { ClienteId = cliente.Id, CilindroId = cilindroId });

        foreach (var agujaCorrederaId in _model.AgujasCorrederaList)
            db.ClienteAgujasCorrederas.Add(new ClienteAgujasCorredera { ClienteId = cliente.Id, AgujaCorrederaId = agujaCorrederaId });

        db.ClienteConfiguracionPuerta.Add(new ClienteConfiguracionPuerta
        {
            ClienteId = cliente.Id,
            PorteroElectrico = _model.PorteroElectrico,
            Cilindro = _model.Cilindro
        });

        db.ClienteCilindrosCorredera.Add(new ClienteCilindroCorredera
        {
            ClienteId = cliente.Id,
            Cilindro = _model.CilindroCorredera
        });

        db.ClienteConfiguracionElevablePlegables.Add(new ClienteConfiguracionElevablePlegable
        {
            ClienteId = cliente.Id,
            Elevable_Estandar = _model.Elevable_Estandar,
            Elevable_Dlo = _model.Elevable_Dlo,
            Plegable_Consumen = _model.Plegable_Consumen
        });

        foreach (var maquina in _model.MaquinasList)
        {
            db.ClienteMaquinas.Add(new ClienteMaquina
            {
                ClienteId = cliente.Id,
                MaquinaTipoId = maquina.MaquinaTipoId,
                MaquinaMarcaId = maquina.MaquinaMarcaId,
                MaquinaMantenimientoId = maquina.MaquinaMantenimientoId,
                Observaciones = maquina.Observaciones
            });
        }

        db.ClienteConfiguracionMaquinas.Add(new ClienteConfiguracionMaquinas
        {
            ClienteId = cliente.Id,
            BisagrasSoldadora = _model.BisagraEnSoldadora,
            TripleTaladroCentro = _model.TripleTaladroCentro,
            SoporteMarcoId = _model.SoporteMarcoConfigId
        });

        foreach (var documento in _model.DocumentosList)
        {
            db.ClienteDocumentos.Add(new ClienteDocumento
            {
                ClienteId = cliente.Id,
                Nombre = documento.Nombre,
                NombreFicheroOriginal = documento.NombreFicheroOriginal,
                Extension = documento.Extension,
                Contenido = documento.Contenido,
                TamañoBytes = documento.TamañoBytes,
                FechaAlta = DateTime.Now
            });
        }

        // Aguja de montaje: fila única (Balconera + Puerta secundaria +
        // Puerta) — ver nota de "Caso especial" más arriba.
        db.ClienteAgujases.Add(new ClienteAgujas
        {
            ClienteId = cliente.Id,
            AgujaBalconeraTipoId = _model.AgujaBalconeraTipo,
            AgujaBalconeraId = _model.AgujaBalconera,
            AgujaPuertaSecTipoId = _model.AgujaPuertaSecTipo,
            AgujaPuertaSecId = _model.AgujaPuertaSec,
            AgujaPuertaTipoId = _model.AgujaPuertaTipo,
            AgujaPuertaId = _model.AgujaPuerta
        });

        if (_model.AgujasModeloPerfilList.Count > 0)
        {
            if (_model.AgujaBalconeraTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.Balconera);

            if (_model.AgujaPuertaSecTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.PuertaSecundaria);

            if (_model.AgujaPuertaTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.Puerta);
        }

        await db.SaveChangesAsync();
    }

    private void AgregarAgujasModeloPerfil(ApplicationDbContext db, int clienteId, int agujaModeloTipoId)
    {
        var nuevos = _model.AgujasModeloPerfilList
            .Where(x => x.AgujaModeloTipoId == agujaModeloTipoId)
            .Select(x => new ClienteAgujasModeloPerfil
            {
                ClienteId = clienteId,
                AgujaModeloTipoId = x.AgujaModeloTipoId,
                AgujaId = x.AgujaId,
                PerfilId = x.PerfilId
            });

        db.ClienteAgujasModeloPerfil.AddRange(nuevos);
    }

    private async Task ActualizarClienteAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var cliente = await db.Clientes
            .Include(c => c.ClientePerfilTipos)
            .Include(c => c.ClientePerfiles)
            .Include(c => c.ClienteManillas)
            .Include(c => c.ClienteSoporteCompases)
            .Include(c => c.ClienteSoftwares)
            .Include(c => c.ClienteSeguridadVentanas)
            .Include(c => c.ClienteCremonaPasivaVentanas)
            .Include(c => c.ClienteCremonaPasivaVentanasPract)
            .Include(c => c.ClienteSeguridadBalconeras)
            .Include(c => c.ClienteCremonaPasivaBalconeras)
            .Include(c => c.ClienteBisagraPuertasSec)
            .Include(c => c.ClienteCerradurasPuertaSec)
            .Include(c => c.ClienteBisagraPuertas)
            .Include(c => c.ClienteCerradurasPuerta)
            .Include(c => c.ClienteCilindros)
            .Include(c => c.ClienteAgujasCorredera)
            .Include(c => c.ClienteMaquinas)
            .Include(c => c.ClienteDocumentos)
            .FirstAsync(c => c.Id == _model.Id);

        cliente.Nombre = _model.Nombre;
        cliente.SapId = _model.SapId;
        cliente.Alias = _model.Alias;
        cliente.Comentarios = _model.Comentarios;
        cliente.ResponsableId = _model.ResponsableId;
        cliente.ObservacionesVentanas = _model.ObservacionesVentanas;
        cliente.ObservacionesBalconeras = _model.ObservacionesBalconeras;
        cliente.ObservacionesPuertas = _model.ObservacionesPuertas;
        cliente.ObservacionesCorrederas = _model.ObservacionesCorrederas;
        cliente.ObservacionesElevables = _model.ObservacionesElevables;
        cliente.ObservacionesPlegables = _model.ObservacionesPlegables;
        cliente.ObservacionesMaquinas = _model.ObservacionesMaquinas;
        cliente.ObservacionesDocumentos = _model.ObservacionesDocumentos;

        // Tipos de perfil
        foreach (var eliminar in cliente.ClientePerfilTipos.Where(x => !_model.PerfilTipoList.Contains(x.PerfilTipoId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.PerfilTipoList.Where(id => !cliente.ClientePerfilTipos.Any(x => x.PerfilTipoId == id)))
            cliente.ClientePerfilTipos.Add(new ClientePerfilTipo { ClienteId = cliente.Id, PerfilTipoId = id });

        // Perfiles
        foreach (var eliminar in cliente.ClientePerfiles.Where(x => !_model.PerfilesList.Contains(x.PerfilId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.PerfilesList.Where(id => !cliente.ClientePerfiles.Any(x => x.PerfilId == id)))
            cliente.ClientePerfiles.Add(new ClientePerfil { ClienteId = cliente.Id, PerfilId = id });

        // Manillas
        foreach (var eliminar in cliente.ClienteManillas.Where(x => !_model.ManillasList.Contains(x.ManillaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.ManillasList.Where(id => !cliente.ClienteManillas.Any(x => x.ManillaId == id)))
            cliente.ClienteManillas.Add(new ClienteManilla { ClienteId = cliente.Id, ManillaId = id });

        // Soporte compás
        foreach (var eliminar in cliente.ClienteSoporteCompases.Where(x => !_model.SoporteCompasList.Contains(x.SoporteCompasId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.SoporteCompasList.Where(id => !cliente.ClienteSoporteCompases.Any(x => x.SoporteCompasId == id)))
            cliente.ClienteSoporteCompases.Add(new ClienteSoporteCompas { ClienteId = cliente.Id, SoporteCompasId = id });

        // Software (selección única, modelada como lista igual que en la app legacy)
        foreach (var eliminar in cliente.ClienteSoftwares.Where(x => !_model.SoftwareList.Contains(x.SoftwareId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.SoftwareList.Where(id => !cliente.ClienteSoftwares.Any(x => x.SoftwareId == id)))
            cliente.ClienteSoftwares.Add(new ClienteSoftware { ClienteId = cliente.Id, SoftwareId = id });

        // Seguridad ventana
        foreach (var eliminar in cliente.ClienteSeguridadVentanas.Where(x => !_model.SeguridadVentanaList.Contains(x.SeguridadVentanaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.SeguridadVentanaList.Where(id => !cliente.ClienteSeguridadVentanas.Any(x => x.SeguridadVentanaId == id)))
            cliente.ClienteSeguridadVentanas.Add(new ClienteSeguridadVentana { ClienteId = cliente.Id, SeguridadVentanaId = id });

        // Cremona pasiva (oscilobatientes)
        foreach (var eliminar in cliente.ClienteCremonaPasivaVentanas.Where(x => !_model.CremonaPasivaVentanaList.Contains(x.CremonaPasivaVentanaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CremonaPasivaVentanaList.Where(id => !cliente.ClienteCremonaPasivaVentanas.Any(x => x.CremonaPasivaVentanaId == id)))
            cliente.ClienteCremonaPasivaVentanas.Add(new ClienteCremonaPasivaVentana { ClienteId = cliente.Id, CremonaPasivaVentanaId = id });

        // Cremona pasiva (practicables)
        foreach (var eliminar in cliente.ClienteCremonaPasivaVentanasPract.Where(x => !_model.CremonaPasivaVentanaPractList.Contains(x.CremonaPasivaVentanaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CremonaPasivaVentanaPractList.Where(id => !cliente.ClienteCremonaPasivaVentanasPract.Any(x => x.CremonaPasivaVentanaId == id)))
            cliente.ClienteCremonaPasivaVentanasPract.Add(new ClienteCremonaPasivaVentanaPract { ClienteId = cliente.Id, CremonaPasivaVentanaId = id });

        // Seguridad balconera
        foreach (var eliminar in cliente.ClienteSeguridadBalconeras.Where(x => !_model.SeguridadBalconeraList.Contains(x.SeguridadBalconeraId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.SeguridadBalconeraList.Where(id => !cliente.ClienteSeguridadBalconeras.Any(x => x.SeguridadBalconeraId == id)))
            cliente.ClienteSeguridadBalconeras.Add(new ClienteSeguridadBalconera { ClienteId = cliente.Id, SeguridadBalconeraId = id });

        // Cremona pasiva (balconeras)
        foreach (var eliminar in cliente.ClienteCremonaPasivaBalconeras.Where(x => !_model.CremonaPasivaBalconeraList.Contains(x.CremonaPasivaBalconeraId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CremonaPasivaBalconeraList.Where(id => !cliente.ClienteCremonaPasivaBalconeras.Any(x => x.CremonaPasivaBalconeraId == id)))
            cliente.ClienteCremonaPasivaBalconeras.Add(new ClienteCremonaPasivaBalconera { ClienteId = cliente.Id, CremonaPasivaBalconeraId = id });

        // Bisagras puerta secundaria
        foreach (var eliminar in cliente.ClienteBisagraPuertasSec.Where(x => !_model.BisagrasPuertaSecList.Contains(x.BisagraPuertaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.BisagrasPuertaSecList.Where(id => !cliente.ClienteBisagraPuertasSec.Any(x => x.BisagraPuertaId == id)))
            cliente.ClienteBisagraPuertasSec.Add(new ClienteBisagraPuertaSec { ClienteId = cliente.Id, BisagraPuertaId = id });

        // Cerraduras puerta secundaria
        foreach (var eliminar in cliente.ClienteCerradurasPuertaSec.Where(x => !_model.CerradurasPuertaSecList.Contains(x.CerraduraPuertaSecId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CerradurasPuertaSecList.Where(id => !cliente.ClienteCerradurasPuertaSec.Any(x => x.CerraduraPuertaSecId == id)))
            cliente.ClienteCerradurasPuertaSec.Add(new ClienteCerraduraPuertaSec { ClienteId = cliente.Id, CerraduraPuertaSecId = id });

        // Bisagras puerta principal
        foreach (var eliminar in cliente.ClienteBisagraPuertas.Where(x => !_model.BisagrasPuertaList.Contains(x.BisagraPuertaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.BisagrasPuertaList.Where(id => !cliente.ClienteBisagraPuertas.Any(x => x.BisagraPuertaId == id)))
            cliente.ClienteBisagraPuertas.Add(new ClienteBisagraPuerta { ClienteId = cliente.Id, BisagraPuertaId = id });

        // Cerraduras puerta principal
        foreach (var eliminar in cliente.ClienteCerradurasPuerta.Where(x => !_model.CerradurasPuertaList.Contains(x.CerraduraPuertaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CerradurasPuertaList.Where(id => !cliente.ClienteCerradurasPuerta.Any(x => x.CerraduraPuertaId == id)))
            cliente.ClienteCerradurasPuerta.Add(new ClienteCerraduraPuerta { ClienteId = cliente.Id, CerraduraPuertaId = id });

        // Cilindros
        foreach (var eliminar in cliente.ClienteCilindros.Where(x => !_model.CilindroList.Contains(x.CilindroId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.CilindroList.Where(id => !cliente.ClienteCilindros.Any(x => x.CilindroId == id)))
            cliente.ClienteCilindros.Add(new ClienteCilindro { ClienteId = cliente.Id, CilindroId = id });

        // Agujas de corredera
        foreach (var eliminar in cliente.ClienteAgujasCorredera.Where(x => !_model.AgujasCorrederaList.Contains(x.AgujaCorrederaId)).ToList())
            db.Remove(eliminar);
        foreach (var id in _model.AgujasCorrederaList.Where(id => !cliente.ClienteAgujasCorredera.Any(x => x.AgujaCorrederaId == id)))
            cliente.ClienteAgujasCorredera.Add(new ClienteAgujasCorredera { ClienteId = cliente.Id, AgujaCorrederaId = id });

        // Máquinas: a diferencia de las listas de ids simples, cada fila
        // tiene varios campos propios (tipo, marca, mantenimiento,
        // observaciones), así que el diff se hace por Id en vez de por
        // pertenencia a la lista. Id null = fila nueva (todavía no guardada).
        var idsMaquinasModelo = _model.MaquinasList.Where(m => m.Id.HasValue).Select(m => m.Id!.Value).ToHashSet();
        foreach (var eliminar in cliente.ClienteMaquinas.Where(x => !idsMaquinasModelo.Contains(x.Id)).ToList())
            db.Remove(eliminar);

        foreach (var maquina in _model.MaquinasList)
        {
            if (maquina.Id.HasValue)
            {
                var existente = cliente.ClienteMaquinas.FirstOrDefault(x => x.Id == maquina.Id.Value);
                if (existente is not null)
                {
                    existente.MaquinaTipoId = maquina.MaquinaTipoId;
                    existente.MaquinaMarcaId = maquina.MaquinaMarcaId;
                    existente.MaquinaMantenimientoId = maquina.MaquinaMantenimientoId;
                    existente.Observaciones = maquina.Observaciones;
                }
            }
            else
            {
                cliente.ClienteMaquinas.Add(new ClienteMaquina
                {
                    ClienteId = cliente.Id,
                    MaquinaTipoId = maquina.MaquinaTipoId,
                    MaquinaMarcaId = maquina.MaquinaMarcaId,
                    MaquinaMantenimientoId = maquina.MaquinaMantenimientoId,
                    Observaciones = maquina.Observaciones
                });
            }
        }

        // Configuración de máquinas (bisagras en soldadora, triple taladro, soporte de marco)
        var clienteConfiguracionMaquinas = await db.ClienteConfiguracionMaquinas.FirstOrDefaultAsync(x => x.ClienteId == cliente.Id);
        if (clienteConfiguracionMaquinas is null)
        {
            clienteConfiguracionMaquinas = new ClienteConfiguracionMaquinas { ClienteId = cliente.Id };
            db.ClienteConfiguracionMaquinas.Add(clienteConfiguracionMaquinas);
        }

        clienteConfiguracionMaquinas.BisagrasSoldadora = _model.BisagraEnSoldadora;
        clienteConfiguracionMaquinas.TripleTaladroCentro = _model.TripleTaladroCentro;
        clienteConfiguracionMaquinas.SoporteMarcoId = _model.SoporteMarcoConfigId;

        // Documentos: igual que Máquinas, el diff se hace por Id (null =
        // fichero nuevo, todavía no guardado). Los documentos ya existentes
        // en BBDD solo actualizan su Nombre — el Contenido/Extension/
        // TamañoBytes de esas filas NO viajan de vuelta desde el modelo
        // (CargarModeloAsync no los carga, por peso), así que sobrescribirlos
        // aquí borraría el fichero guardado; exactamente igual que
        // UpdateClienteDocumentos() en la app legacy.
        var idsDocumentosModelo = _model.DocumentosList.Where(d => d.Id.HasValue).Select(d => d.Id!.Value).ToHashSet();
        foreach (var eliminar in cliente.ClienteDocumentos.Where(x => !idsDocumentosModelo.Contains(x.Id)).ToList())
            db.Remove(eliminar);

        foreach (var documento in _model.DocumentosList)
        {
            if (documento.Id.HasValue)
            {
                var existente = cliente.ClienteDocumentos.FirstOrDefault(x => x.Id == documento.Id.Value);
                if (existente is not null)
                    existente.Nombre = documento.Nombre;
            }
            else
            {
                cliente.ClienteDocumentos.Add(new ClienteDocumento
                {
                    ClienteId = cliente.Id,
                    Nombre = documento.Nombre,
                    NombreFicheroOriginal = documento.NombreFicheroOriginal,
                    Extension = documento.Extension,
                    Contenido = documento.Contenido,
                    TamañoBytes = documento.TamañoBytes,
                    FechaAlta = DateTime.Now
                });
            }
        }

        // Configuración de puerta (Cilindro sí/no + Portero eléctrico oculto)
        var clienteConfiguracionPuerta = await db.ClienteConfiguracionPuerta.FirstOrDefaultAsync(x => x.ClienteId == cliente.Id);
        if (clienteConfiguracionPuerta is null)
        {
            clienteConfiguracionPuerta = new ClienteConfiguracionPuerta { ClienteId = cliente.Id };
            db.ClienteConfiguracionPuerta.Add(clienteConfiguracionPuerta);
        }

        clienteConfiguracionPuerta.PorteroElectrico = _model.PorteroElectrico;
        clienteConfiguracionPuerta.Cilindro = _model.Cilindro;

        // Bombillo de corredera (Cilindro sí/no)
        var clienteCilindroCorredera = await db.ClienteCilindrosCorredera.FirstOrDefaultAsync(x => x.ClienteId == cliente.Id);
        if (clienteCilindroCorredera is null)
        {
            clienteCilindroCorredera = new ClienteCilindroCorredera { ClienteId = cliente.Id };
            db.ClienteCilindrosCorredera.Add(clienteCilindroCorredera);
        }

        clienteCilindroCorredera.Cilindro = _model.CilindroCorredera;

        // Elevables/Plegables (Estándar, DLO, Consumen)
        var clienteElevablePlegable = await db.ClienteConfiguracionElevablePlegables.FirstOrDefaultAsync(x => x.ClienteId == cliente.Id);
        if (clienteElevablePlegable is null)
        {
            clienteElevablePlegable = new ClienteConfiguracionElevablePlegable { ClienteId = cliente.Id };
            db.ClienteConfiguracionElevablePlegables.Add(clienteElevablePlegable);
        }

        clienteElevablePlegable.Elevable_Estandar = _model.Elevable_Estandar;
        clienteElevablePlegable.Elevable_Dlo = _model.Elevable_Dlo;
        clienteElevablePlegable.Plegable_Consumen = _model.Plegable_Consumen;

        // Aguja de montaje: fila única (Balconera + Puerta secundaria +
        // Puerta) — ver nota de "Caso especial" más arriba.
        var clienteAgujas = await db.ClienteAgujases.FirstOrDefaultAsync(x => x.ClienteId == cliente.Id);
        if (clienteAgujas is null)
        {
            clienteAgujas = new ClienteAgujas { ClienteId = cliente.Id };
            db.ClienteAgujases.Add(clienteAgujas);
        }

        clienteAgujas.AgujaBalconeraTipoId = _model.AgujaBalconeraTipo;
        clienteAgujas.AgujaBalconeraId = _model.AgujaBalconera;
        clienteAgujas.AgujaPuertaSecTipoId = _model.AgujaPuertaSecTipo;
        clienteAgujas.AgujaPuertaSecId = _model.AgujaPuertaSec;
        clienteAgujas.AgujaPuertaTipoId = _model.AgujaPuertaTipo;
        clienteAgujas.AgujaPuertaId = _model.AgujaPuerta;

        var existentesAgujaPerfil = await db.ClienteAgujasModeloPerfil.Where(x => x.ClienteId == cliente.Id).ToListAsync();
        db.ClienteAgujasModeloPerfil.RemoveRange(existentesAgujaPerfil);

        if (_model.AgujasModeloPerfilList.Count > 0)
        {
            if (_model.AgujaBalconeraTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.Balconera);

            if (_model.AgujaPuertaSecTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.PuertaSecundaria);

            if (_model.AgujaPuertaTipo == (int)AgujaMode.PorPerfil)
                AgregarAgujasModeloPerfil(db, cliente.Id, (int)AgujasTipoModelo.Puerta);
        }

        await db.SaveChangesAsync();
    }
}
