@* Diálogo "Añadir documento": nombre + selector de fichero. Réplica moderna
   de Clientes/DocumentoAsociadoForm.cs (WinForms). El documento solo se
   guarda en BBDD al terminar el wizard (igual que en la app legacy, que
   también difiere el guardado real hasta CrearCliente/ActualizarCliente),
   así que aquí simplemente se lee el fichero en memoria y se añade a
   Model.DocumentosList — misma convención que el resto de diálogos del
   wizard, que mutan el modelo compartido en vez de devolver datos por
   DialogResult. *@
@inject ISnackbar Snackbar
@using System.IO

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@MenuTextos.AnadirDocumento</MudText>
    </TitleContent>
    <DialogContent>
        <MudStack Spacing="4">
            <MudTextField T="string" @bind-Value="_nombre" Label="@MenuTextos.NombreDocumento" Variant="Variant.Outlined" />

            <MudFileUpload T="IBrowserFile" FilesChanged="OnArchivoSeleccionadoAsync"
                           Accept=".pdf,.doc,.docx,.xls,.xlsx,.txt" MaxFileSize="TamanoMaximoBytes">
                <CustomContent Context="cargador">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.AttachFile"
                                   OnClick="@(() => cargador.OpenFilePickerAsync())">
                            @MenuTextos.SeleccionarDocumento
                        </MudButton>
                        <MudText Typo="Typo.body2" Class="mud-text-secondary">
                            @(_nombreFichero ?? MenuTextos.NingunFichero)
                        </MudText>
                    </MudStack>
                </CustomContent>
            </MudFileUpload>
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">@MenuTextos.Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Aceptar">@MenuTextos.Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter, EditorRequired] public ClientWizardModel Model { get; set; } = null!;

    private const long TamanoMaximoBytes = 20 * 1024 * 1024; // 20 MB, igual de generoso que el filtro de la app legacy

    private string? _nombre;
    private string? _nombreFichero;
    private string? _extension;
    private byte[]? _contenido;
    private long _tamanoBytes;

    private async Task OnArchivoSeleccionadoAsync(IBrowserFile? archivo)
    {
        if (archivo is null)
            return;

        await using var stream = archivo.OpenReadStream(TamanoMaximoBytes);
        using var memoria = new MemoryStream();
        await stream.CopyToAsync(memoria);

        _contenido = memoria.ToArray();
        _nombreFichero = archivo.Name;
        _extension = Path.GetExtension(archivo.Name);
        _tamanoBytes = _contenido.LongLength;
    }

    private void Aceptar()
    {
        if (_contenido is null || string.IsNullOrWhiteSpace(_nombreFichero))
        {
            Snackbar.Add(MenuTextos.DocumentoObligatorio, Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_nombre))
        {
            Snackbar.Add(MenuTextos.IndicarNombreDoc, Severity.Warning);
            return;
        }

        Model.DocumentosList.Add(new ClienteDocumentoItem
        {
            Nombre = _nombre.Trim(),
            NombreFicheroOriginal = _nombreFichero,
            Extension = _extension ?? string.Empty,
            Contenido = _contenido,
            TamañoBytes = _tamanoBytes
        });

        MudDialog.Close(DialogResult.Ok(true));
    }

    private void Cancelar() => MudDialog.Cancel();
}
