@* Página de inicio. Réplica moderna del menú principal (Main.cs), pero en
   forma de dashboard en vez de la lista de botones sin más contexto que
   tenía la primera versión: cabecera corporativa compacta, tarjetas de datos
   rápidos (clientes totales, versión de datos, versión de la app) y una
   rejilla de accesos rápidos a los mismos módulos del menú lateral —
   replicando la MISMA lógica de visibilidad por edición que
   Layout/MainLayout.razor (SetVisibilidadModoAplicacion en la app legacy).
   Los accesos a Clientes, Informes y (solo edición Sede/Internal, ver
   mostrarMantenimiento) Mantenimiento incluyen además, en el mismo bloque,
   varios accesos secundarios en miniatura (Nuevo cliente/Importar/Exportar
   en el de Clientes; filtros rápidos de Tipo de perfil/Máquinas en el de
   Informes; Usuarios/Bisagras/Cerraduras en el de Mantenimiento) para que se
   entienda que están relacionados con ellos. Todas las tarjetas de accesos
   rápidos (agrupadas o no) usan la misma altura — ver .rgc-home-access en
   app.css — para que la rejilla quede alineada aunque unas tengan miniaturas
   debajo y otras no. *@
@page "/"
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IAppHost AppHost
@inject VersionDatosState VersionDatosState
@inject NavigationManager NavigationManager
@inject IDialogService DialogService
@inject SesionState SesionState
@using Microsoft.EntityFrameworkCore

<div class="rgc-home">
    <div class="rgc-home-hero">
        <img src="_content/RotoGestionClientes.UI/images/app-icon.png" alt="RotoGestionClientes" />
        <div>
            <MudText Typo="Typo.h4" Class="mb-1">@MenuTextos.Bienvenida</MudText>
            <MudText Typo="Typo.body1">@MenuTextos.BienvenidaTexto</MudText>
        </div>
    </div>

    <MudGrid Class="mt-4" Spacing="3">
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="rgc-home-stat pa-4">
                <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5">@(_totalClientes?.ToString() ?? "—")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@MenuTextos.TotalClientes</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="rgc-home-stat pa-4">
                <MudIcon Icon="@Icons.Material.Filled.Storage" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5">@(VersionDatosState.Version ?? "—")</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@MenuTextos.VersionDatos</MudText>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" sm="4">
            <MudPaper Outlined="true" Class="rgc-home-stat pa-4">
                <MudIcon Icon="@Icons.Material.Filled.Info" Color="Color.Primary" Size="Size.Large" />
                <MudText Typo="Typo.h5">v@(AppHost.AppVersion)</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">@MenuTextos.VersionApp</MudText>
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-6 mb-3">@MenuTextos.AccesosRapidos</MudText>

    <MudGrid Spacing="3">
        @if (_mostrarClientes)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Outlined="true" Class="rgc-home-access rgc-home-access-grouped pa-4">
                    <div class="rgc-home-access-main" @onclick="@(() => NavigationManager.NavigateTo("/clientes"))">
                        <MudIcon Icon="@Icons.Material.Filled.People" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="mt-2">@MenuTextos.Clientes</MudText>
                    </div>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-2">
                        <MudTooltip Text="@MenuTextos.NuevoCliente">
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo("/clientes/nuevo"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.ImportarCliente">
                            <MudIconButton Icon="@Icons.Material.Filled.FileDownload" Size="Size.Small" Color="Color.Primary"
                                           OnClick="AbrirImportacionAsync" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.ExportarClientes">
                            <MudIconButton Icon="@Icons.Material.Filled.FileUpload" Size="Size.Small" Color="Color.Primary"
                                           OnClick="AbrirExportacionMultipleAsync" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        @if (_mostrarInformes)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Outlined="true" Class="rgc-home-access rgc-home-access-grouped pa-4">
                    <div class="rgc-home-access-main" @onclick="@(() => NavigationManager.NavigateTo("/informes"))">
                        <MudIcon Icon="@Icons.Material.Filled.Assessment" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="mt-2">@MenuTextos.Informes</MudText>
                    </div>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-2">
                        <MudTooltip Text="@MenuTextos.AccesoTipoPerfilAluminio">
                            <MudIconButton Icon="@Icons.Material.Filled.Straighten" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/informes?tipoPerfilId={PerfilTipoIdAluminio}"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.AccesoTipoPerfilPVC">
                            <MudIconButton Icon="@Icons.Material.Filled.Straighten" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/informes?tipoPerfilId={PerfilTipoIdPvc}"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.AccesoMaquinasMesaHerraje">
                            <MudIconButton Icon="@Icons.Material.Filled.Category" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/informes?maquinaId={MaquinaTipoIdMesaHerraje}"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.InformeAcciones">
                            <MudIconButton Icon="@Icons.Material.Filled.BarChart" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo("/informes/acciones"))" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        @if (_mostrarMantenimiento)
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Outlined="true" Class="rgc-home-access rgc-home-access-grouped pa-4">
                    <div class="rgc-home-access-main" @onclick="@(() => NavigationManager.NavigateTo("/mantenimiento"))">
                        <MudIcon Icon="@Icons.Material.Filled.Build" Color="Color.Primary" Size="Size.Large" />
                        <MudText Typo="Typo.subtitle1" Class="mt-2">@MenuTextos.Mantenimiento</MudText>
                    </div>
                    <MudStack Row="true" Justify="Justify.Center" Spacing="1" Class="mt-2">
                        <MudTooltip Text="@MenuTextos.Usuarios">
                            <MudIconButton Icon="@Icons.Material.Filled.People" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/mantenimiento?tabla={MaestroTipo.Usuario}"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.Bisagras">
                            <MudIconButton Icon="@RgcIcons.Bisagras" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/mantenimiento?tabla={MaestroTipo.BisagraPuerta}"))" />
                        </MudTooltip>
                        <MudTooltip Text="@MenuTextos.Cerraduras">
                            <MudIconButton Icon="@Icons.Material.Filled.VpnKey" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => NavigationManager.NavigateTo($"/mantenimiento?tabla={MaestroTipo.CerraduraPuerta}"))" />
                        </MudTooltip>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }

        @foreach (var item in _accesos.Where(a => a.Visible))
        {
            <MudItem xs="12" sm="6" md="4" lg="3">
                <MudPaper Outlined="true" Class="rgc-home-access pa-4" @onclick="@item.OnClick">
                    <MudIcon Icon="@item.Icon" Color="Color.Primary" Size="Size.Large" />
                    <MudText Typo="Typo.subtitle1" Class="mt-2">@item.Label</MudText>
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
</div>

@code {
    private int? _totalClientes;
    private bool _mostrarClientes;
    private bool _mostrarMantenimiento;
    private bool _mostrarInformes;
    private List<AccesoRapido> _accesos = new();

    private sealed record AccesoRapido(string Label, string Icon, bool Visible, Action OnClick);

    // Ids fijos de dbo.PerfilTipo / dbo.MaquinaTipos: catálogos "cerrados"
    // con el mismo Id en CreateDb.txt (ES) y CreateDb-PT.txt (PT) aunque el
    // Nombre/Descripcion cambie de idioma o de distribuidor. Si algún día se
    // reordenan esos scripts, estos números hay que revisarlos a la vez.
    private const int PerfilTipoIdAluminio = 1;
    private const int PerfilTipoIdPvc = 2;
    private const int MaquinaTipoIdMesaHerraje = 4;

    protected override async Task OnInitializedAsync()
    {
        await CargarTotalClientesAsync();

        await using var db = await DbFactory.CreateDbContextAsync();
        var config = await db.ConfiguracionAplicacion.AsNoTracking().FirstOrDefaultAsync();

        var edition = ApplicationEdition.Internal;
        if (config is not null)
        {
            Enum.TryParse(config.AppEdition, out edition);
        }

        // Misma regla de visibilidad que Main.SetVisibilidadModoAplicacion()
        // en la app WinForms actual / Layout/MainLayout.razor, combinada con
        // los permisos por módulo de la cuenta (SesionState.TieneAccesoModulo)
        // -- mismo criterio que MainLayout.razor para que el Dashboard nunca
        // muestre un acceso rápido a algo que el menú lateral ya oculta.
        bool mostrarMantenimiento;
        bool mostrarCrearActualizacion;
        bool mostrarActualizarDatos;

        switch (edition)
        {
            case ApplicationEdition.Distributor:
                mostrarMantenimiento = false;
                mostrarCrearActualizacion = false;
                mostrarActualizarDatos = true;
                break;
            case ApplicationEdition.Internal:
                mostrarMantenimiento = true;
                mostrarCrearActualizacion = true;
                mostrarActualizarDatos = false;
                break;
            default: // Debug / desconocido: se muestra todo
                mostrarMantenimiento = true;
                mostrarCrearActualizacion = true;
                mostrarActualizarDatos = true;
                break;
        }

        _mostrarClientes = SesionState.TieneAccesoModulo(Modulo.Clientes);
        _mostrarInformes = SesionState.TieneAccesoModulo(Modulo.Informes);
        _mostrarMantenimiento = mostrarMantenimiento && SesionState.TieneAccesoModulo(Modulo.Mantenimiento);
        mostrarCrearActualizacion = mostrarCrearActualizacion && SesionState.TieneAccesoModulo(Modulo.CrearActualizacion);
        mostrarActualizarDatos = mostrarActualizarDatos && SesionState.TieneAccesoModulo(Modulo.ActualizarDatos);

        // Clientes, Informes y Mantenimiento NO están en esta lista: se
        // dibujan aparte, como tarjetas "agrupadas" con sus propios accesos
        // secundarios en miniatura debajo (ver el marcado más arriba).
        _accesos =
        [
            new AccesoRapido(MenuTextos.CrearActualizacion, Icons.Material.Filled.CloudUpload, mostrarCrearActualizacion, () => NavigationManager.NavigateTo("/crear-actualizacion")),
            new AccesoRapido(MenuTextos.ActualizarDatos, Icons.Material.Filled.CloudDownload, mostrarActualizarDatos, () => NavigationManager.NavigateTo("/actualizar-datos")),
        ];
    }

    private async Task CargarTotalClientesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        _totalClientes = await db.Clientes.CountAsync();
    }

    private async Task AbrirImportacionAsync()
    {
        var parametros = new DialogParameters();
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialogo = await DialogService.ShowAsync<ClienteImportDialog>(MenuTextos.ImportarCliente, parametros, opciones);
        var resultado = await dialogo.Result;

        if (resultado is not null && !resultado.Canceled)
        {
            await CargarTotalClientesAsync();
        }
    }

    private async Task AbrirExportacionMultipleAsync()
    {
        var parametros = new DialogParameters();
        var opciones = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };

        var dialogo = await DialogService.ShowAsync<ClienteExportDialog>(MenuTextos.SeleccionarClientes, parametros, opciones);
        await dialogo.Result;

        // El diálogo no cambia datos de cliente, solo exporta, así que no
        // hace falta recargar el total de clientes al cerrarse.
    }
}
