@* Diálogo para que un Administrador resetee la contraseña de otra cuenta:
   fija una contraseña temporal y fuerza DebeCambiarPassword=true, igual que
   ocurre al crear la cuenta (ver CuentaUsuarioEditDialog.razor), así que la
   persona titular la cambia por una propia en su siguiente inicio de sesión
   (ver Pages/Login.razor). Nunca se guarda ni se muestra la contraseña en
   claro: se hashea igual que en el resto de la app, con
   Microsoft.AspNetCore.Identity.PasswordHasher&lt;CuentaUsuario&gt;. *@
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject ISnackbar Snackbar
@inject AuditoriaService AuditoriaService
@using Microsoft.AspNetCore.Identity
@using Microsoft.EntityFrameworkCore

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@MenuTextos.ResetearPassword — @Login</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3">@MenuTextos.ResetearPasswordTexto</MudText>

        <MudStack Spacing="3">
            <MudTextField T="string" @bind-Value="_passwordTemporal" Label="@MenuTextos.PasswordTemporal" Variant="Variant.Outlined"
                          InputType="InputType.Password" Immediate="true" />

            <MudTextField T="string" @bind-Value="_confirmarPasswordTemporal" Label="@MenuTextos.ConfirmarPasswordTemporal" Variant="Variant.Outlined"
                          InputType="InputType.Password" Immediate="true" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancelar">@MenuTextos.Cancelar</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AceptarAsync" Disabled="_guardando">@MenuTextos.Guardar</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const int LongitudMinimaPassword = 8;

    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter, EditorRequired] public int CuentaUsuarioId { get; set; }
    [Parameter, EditorRequired] public string Login { get; set; } = string.Empty;

    private readonly PasswordHasher<CuentaUsuario> _hasher = new();
    private bool _guardando;
    private string _passwordTemporal = string.Empty;
    private string _confirmarPasswordTemporal = string.Empty;

    private async Task AceptarAsync()
    {
        if (_passwordTemporal.Length < LongitudMinimaPassword)
        {
            Snackbar.Add(MenuTextos.PasswordDemasiadoCorta, Severity.Warning);
            return;
        }

        if (_passwordTemporal != _confirmarPasswordTemporal)
        {
            Snackbar.Add(MenuTextos.PasswordsNoCoinciden, Severity.Warning);
            return;
        }

        _guardando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            var cuenta = await db.CuentasUsuario.FirstAsync(x => x.Id == CuentaUsuarioId);
            cuenta.PasswordHash = _hasher.HashPassword(cuenta, _passwordTemporal);
            cuenta.DebeCambiarPassword = true;

            AuditoriaService.Registrar(db, AuditoriaAccionTipo.Modificar, "CuentaUsuario", cuenta.Id, $"{cuenta.Login} — {MenuTextos.ResetearPassword}");
            await db.SaveChangesAsync();

            Snackbar.Add(MenuTextos.PasswordReseteada, Severity.Success, config => { config.SnackbarVariant = Variant.Filled; });

            MudDialog.Close(DialogResult.Ok(true));
        }
        finally
        {
            _guardando = false;
        }
    }

    private void Cancelar() => MudDialog.Cancel();
}
