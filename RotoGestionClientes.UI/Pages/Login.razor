@* Pantalla de login. MainLayout.razor la muestra en vez de todo el chrome
   habitual (AppBar/Drawer/@@Body) mientras SesionState.EstaAutenticado sea
   false -- @@Body ni siquiera se renderiza en ese caso, así que no hay
   ninguna página accesible sin haber iniciado sesión.

   Dos pasos: credenciales, y --si la cuenta tiene DebeCambiarPassword (alta
   nueva o reseteo de contraseña por un Administrador)-- fijar una
   contraseña nueva antes de conceder acceso. Ver Services/AuthService.cs
   para por qué el cambio de sesión se retrasa hasta que ese paso termina. *@
@inject AuthService AuthService
@inject IAppHost AppHost

<div class="rgc-login">
    <MudPaper Outlined="true" Class="rgc-login-card pa-8">
        <div class="rgc-login-header">
            <MudImage Src="_content/RotoGestionClientes.UI/images/logo-main.png" Height="40" ObjectFit="ObjectFit.Contain" />
            <MudText Typo="Typo.h5" Class="mt-3">@MenuTextos.IniciarSesionTitulo</MudText>
        </div>

        @if (_errorConexion)
        {
            @* No se puede llegar a la BBDD (servidor caído, cadena de
               conexión mal configurada, sin red...). En vez de dejar que la
               excepción suba sin control y se vea la barra roja genérica de
               Blazor ("Se ha producido un error inesperado. Recargar"), que
               transmite desconfianza porque no dice qué ha pasado ni qué
               hacer, se sustituye toda la tarjeta de login por un aviso
               claro con la conexión configurada (sin credenciales) y tres
               acciones concretas para poder resolverlo sin ayuda técnica. *@
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-4" Icon="@Icons.Material.Filled.CloudOff">
                <MudText Typo="Typo.subtitle1" Class="mb-1">@MenuTextos.ErrorConexionTitulo</MudText>
                <MudText Typo="Typo.body2">@MenuTextos.ErrorConexionTexto</MudText>

                @if (!string.IsNullOrEmpty(AppHost.InfoConexion))
                {
                    <MudText Typo="Typo.caption" Class="mt-3 d-block">
                        @MenuTextos.ConexionConfigurada: @AppHost.InfoConexion
                    </MudText>
                }
            </MudAlert>

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                       StartIcon="@Icons.Material.Filled.Refresh" OnClick="ReintentarAsync">
                @MenuTextos.Reintentar
            </MudButton>

            <MudButton Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.FolderOpen" OnClick="@(() => AppHost.AbrirCarpetaConfiguracion())">
                @MenuTextos.AbrirCarpetaConfiguracion
            </MudButton>

            <MudButton Variant="Variant.Text" Color="Color.Error" FullWidth="true" Class="mt-2"
                       StartIcon="@Icons.Material.Filled.ExitToApp" OnClick="@(() => AppHost.Exit())">
                @MenuTextos.Salir
            </MudButton>
        }
        else if (_paso == PasoLogin.Credenciales)
        {
            <MudTextField T="string" @bind-Value="_login" Label="@MenuTextos.UsuarioLogin" Variant="Variant.Outlined"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Person"
                          Disabled="_cargando" Immediate="true" Class="mt-4"
                          OnKeyDown="@(async e => { if (e.Key == "Enter") await EntrarAsync(); })" />

            <MudTextField T="string" @bind-Value="_password" Label="@MenuTextos.Contrasena" Variant="Variant.Outlined"
                          InputType="InputType.Password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Disabled="_cargando" Immediate="true" Class="mt-3"
                          OnKeyDown="@(async e => { if (e.Key == "Enter") await EntrarAsync(); })" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                       Disabled="_cargando" OnClick="EntrarAsync">
                @MenuTextos.Entrar
            </MudButton>
        }
        else
        {
            <MudText Typo="Typo.body2" Class="mt-4 mb-2">@MenuTextos.DebeCambiarPasswordTexto</MudText>

            <MudTextField T="string" @bind-Value="_nuevaPassword" Label="@MenuTextos.NuevaContrasena" Variant="Variant.Outlined"
                          InputType="InputType.Password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Disabled="_cargando" Immediate="true" Class="mt-2" />

            <MudTextField T="string" @bind-Value="_confirmarPassword" Label="@MenuTextos.ConfirmarContrasena" Variant="Variant.Outlined"
                          InputType="InputType.Password" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Lock"
                          Disabled="_cargando" Immediate="true" Class="mt-3"
                          OnKeyDown="@(async e => { if (e.Key == "Enter") await GuardarNuevaPasswordAsync(); })" />

            @if (!string.IsNullOrEmpty(_error))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-3">@_error</MudAlert>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-4"
                       Disabled="_cargando" OnClick="GuardarNuevaPasswordAsync">
                @MenuTextos.GuardarContrasena
            </MudButton>
        }
    </MudPaper>
</div>

@code {
    private enum PasoLogin { Credenciales, CambiarPassword }

    private const int LongitudMinimaPassword = 8;

    private PasoLogin _paso = PasoLogin.Credenciales;
    private string _login = string.Empty;
    private string _password = string.Empty;
    private string _nuevaPassword = string.Empty;
    private string _confirmarPassword = string.Empty;
    private string? _error;
    private bool _cargando;
    private bool _errorConexion;
    private CuentaUsuario? _cuentaPendiente;

    private async Task EntrarAsync()
    {
        if (_cargando)
            return;

        if (string.IsNullOrWhiteSpace(_login) || string.IsNullOrWhiteSpace(_password))
        {
            _error = MenuTextos.CredencialesIncompletas;
            return;
        }

        _cargando = true;
        _error = null;
        _errorConexion = false;

        try
        {
            var resultado = await AuthService.VerificarCredencialesAsync(_login.Trim(), _password);

            if (!resultado.Exito || resultado.Cuenta is null)
            {
                // CuentaInactiva sí se distingue del resto de fallos (usuario
                // inexistente o contraseña incorrecta, que se agrupan en un
                // único mensaje para no dar pistas de cuál de los dos
                // falló): así se sabe si hay que revisar lo escrito o pedirle
                // a un Administrador que reactive la cuenta.
                _error = resultado.CuentaInactiva ? MenuTextos.CuentaInactivaTexto : MenuTextos.CredencialesIncorrectas;
                return;
            }

            if (resultado.RequiereCambioPassword)
            {
                _cuentaPendiente = resultado.Cuenta;
                _password = string.Empty;
                _paso = PasoLogin.CambiarPassword;
            }
            else
            {
                AuthService.EstablecerSesion(resultado.Cuenta);
            }
        }
        catch (Exception)
        {
            // No se ha podido ni siquiera consultar dbo.CuentaUsuario: servidor
            // apagado/inalcanzable, cadena de conexión mal configurada, sin
            // red, etc. -- no es un fallo de credenciales, es que no se ha
            // podido hablar con la BBDD en absoluto. En vez de dejar que la
            // excepción suba sin control (lo que en un BlazorWebView deja la
            // pantalla en un estado roto con la barra roja "Recargar" de
            // Blazor, sin explicar nada), se captura aquí y se sustituye la
            // tarjeta de login por un aviso claro con opciones. No se
            // registra el detalle técnico en pantalla a propósito: a la
            // persona usuaria no le sirve de nada un mensaje de SqlException
            // y solo transmite desconfianza.
            _errorConexion = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    private async Task GuardarNuevaPasswordAsync()
    {
        if (_cargando || _cuentaPendiente is null)
            return;

        if (_nuevaPassword.Length < LongitudMinimaPassword)
        {
            _error = MenuTextos.PasswordDemasiadoCorta;
            return;
        }

        if (_nuevaPassword != _confirmarPassword)
        {
            _error = MenuTextos.PasswordsNoCoinciden;
            return;
        }

        _cargando = true;
        _error = null;
        _errorConexion = false;

        try
        {
            var cuentaActualizada = await AuthService.CambiarPasswordAsync(_cuentaPendiente.Id, _nuevaPassword);
            if (cuentaActualizada is null)
            {
                _error = MenuTextos.ErrorGenerico;
                return;
            }

            AuthService.EstablecerSesion(cuentaActualizada);
        }
        catch (Exception)
        {
            // Mismo escenario que en EntrarAsync: se ha perdido la conexión
            // con la BBDD justo al fijar la contraseña nueva (menos
            // frecuente, pero posible si el servidor cae entre medias).
            _errorConexion = true;
        }
        finally
        {
            _cargando = false;
        }
    }

    /// <summary>
    /// Botón "Reintentar" del aviso de error de conexión: repite la misma
    /// operación que falló (login o cambio de contraseña, según en qué paso
    /// estuviera) sin que la persona tenga que volver a escribir nada.
    /// </summary>
    private Task ReintentarAsync() => _paso == PasoLogin.CambiarPassword
        ? GuardarNuevaPasswordAsync()
        : EntrarAsync();
}
