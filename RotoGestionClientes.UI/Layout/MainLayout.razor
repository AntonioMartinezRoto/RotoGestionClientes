@inherits LayoutComponentBase
@implements IDisposable
@inject IDbContextFactory<ApplicationDbContext> DbFactory
@inject IAppHost AppHost
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager
@inject VersionDatosState VersionDatosState
@using Microsoft.EntityFrameworkCore

<MudThemeProvider Theme="RgcTheme.Theme" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1">
        <MudImage Src="_content/RotoGestionClientes.UI/images/logo-main.png" Height="34" ObjectFit="ObjectFit.Contain" Class="mr-4" />
        <MudText Typo="Typo.h6">@MenuTextos.MenuPrincipal</MudText>
        <MudSpacer />
        <MudText Typo="Typo.body2" Class="mr-2">@MenuTextos.VersionDatos: @(VersionDatosState.Version ?? "—")</MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">v@(AppHost.AppVersion)</MudText>
    </MudAppBar>

    <MudDrawer Open="true" Elevation="0" Variant="DrawerVariant.Persistent" ClipMode="DrawerClipMode.Always">
        <MudNavMenu Class="pa-2">
            @foreach (var item in _menuItems.Where(i => i.Visible))
            {
                <MudNavLink Icon="@item.Icon" IconColor="Color.Primary" OnClick="@item.OnClick" Class="rgc-nav-link">
                    @item.Label
                </MudNavLink>
            }
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    private List<MenuItem> _menuItems = new();

    private sealed record MenuItem(string Label, string Icon, bool Visible, Action OnClick);

    protected override async Task OnInitializedAsync()
    {
        // MainLayout no se reinstancia al navegar entre páginas, así que
        // escuchamos VersionDatosState.Changed para refrescar la cabecera al
        // instante cuando se guarda un maestro en Mantenimiento (ver
        // MaestroEditDialog), sin depender de recargar la página.
        VersionDatosState.Changed += OnVersionDatosCambiada;

        await using var db = await DbFactory.CreateDbContextAsync();

        var config = await db.ConfiguracionAplicacion
            .AsNoTracking()
            .FirstOrDefaultAsync();

        VersionDatosState.Establecer(config?.VersionMaestros);

        var edition = ApplicationEdition.Internal;
        if (config is not null)
        {
            Enum.TryParse(config.AppEdition, out edition);
        }

        // Misma regla de visibilidad que Main.SetVisibilidadModoAplicacion()
        // en la app WinForms actual.
        bool mostrarMantenimiento;
        bool mostrarCrearActualizacion;
        bool mostrarActualizarDatos;

        switch (edition)
        {
            case ApplicationEdition.Distributor:
                mostrarMantenimiento = false;
                mostrarCrearActualizacion = false;
                mostrarActualizarDatos = true;
                break;
            case ApplicationEdition.Internal:
                mostrarMantenimiento = true;
                mostrarCrearActualizacion = true;
                mostrarActualizarDatos = false;
                break;
            default: // Debug / desconocido: se muestra todo
                mostrarMantenimiento = true;
                mostrarCrearActualizacion = true;
                mostrarActualizarDatos = true;
                break;
        }

        _menuItems =
        [
            new MenuItem(MenuTextos.Clientes, Icons.Material.Filled.People, true, () => NavigationManager.NavigateTo("/clientes")),
            new MenuItem(MenuTextos.Mantenimiento, Icons.Material.Filled.Build, mostrarMantenimiento, () => NavigationManager.NavigateTo("/mantenimiento")),
            new MenuItem(MenuTextos.Informes, Icons.Material.Filled.Assessment, true, ShowComingSoon),
            new MenuItem(MenuTextos.CrearActualizacion, Icons.Material.Filled.CloudUpload, mostrarCrearActualizacion, ShowComingSoon),
            new MenuItem(MenuTextos.ActualizarDatos, Icons.Material.Filled.CloudDownload, mostrarActualizarDatos, ShowComingSoon),
            new MenuItem(MenuTextos.Salir, Icons.Material.Filled.ExitToApp, true, AppHost.Exit),
        ];
    }

    private void ShowComingSoon()
    {
        Snackbar.Add(MenuTextos.ProximamenteTexto, Severity.Info, config => { config.SnackbarVariant = Variant.Filled; });
    }

    private void OnVersionDatosCambiada() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        VersionDatosState.Changed -= OnVersionDatosCambiada;
    }
}
